---
import { site } from "../site.config";

const encodedEmail = Buffer.from(site.email, "utf-8").toString("base64");
---

<footer class="site-footer">
  <div class="wrapper">
    <h2 class="footer-heading">Map Legend</h2>

    <div class="footer-col-wrapper">
      <div class="footer-col footer-col-1">
        <ul class="contact-list">
          <li>{site.title}</li>
          <li>
            <a
              class="email-link"
              data-email={encodedEmail}
              href="#"
              rel="nofollow"
            >
              Email
            </a>
          </li>
        </ul>
      </div>

      <div class="footer-col footer-col-2">
        <ul class="social-media-list">
          {site.linkedinUsername && (
            <li>
              <a href={`https://www.linkedin.com/in/${site.linkedinUsername}`}>
                <span class="username">LinkedIn / {site.linkedinUsername}</span>
              </a>
            </li>
          )}
        </ul>
      </div>

      <div class="footer-col footer-col-3">
        <p class="text">{site.description}</p>
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLAnchorElement>(".email-link").forEach((link) => {
    const encoded = link.dataset.email;
    if (!encoded) return;
    const email = atob(encoded);
    link.href = `mailto:${email}`;
    link.textContent = email;
  });
</script>
