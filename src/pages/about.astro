---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About">
  <h1 class="page-heading">About</h1>

  <div class="info-card">
    <p>
      Hi, I'm Gil — a software engineer working on JavaScript, Node, and PHP.
      I'm currently at Tesla, and I co-organize the NYJavascript Meetup here
      in New York City.
    </p>
    <p>
      I write here about the small, practical things I run into while
      building for the web — CSS tricks, tooling, and whatever else is worth
      remembering later.
    </p>
  </div>

  <ul class="tag-list">
    <li>JavaScript</li>
    <li>Node.js</li>
    <li>PHP</li>
    <li>Tesla</li>
    <li>NYJavascript</li>
    <li>NYC</li>
  </ul>
</Layout>
