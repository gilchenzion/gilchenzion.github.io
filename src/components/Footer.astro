---
import { site } from "../site.config";
---

<footer class="site-footer">
  <div class="wrapper">
    <h2 class="footer-heading">Map Legend</h2>

    <div class="footer-col-wrapper">
      <div class="footer-col footer-col-1">
        <ul class="contact-list">
          <li>{site.title}</li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>

      <div class="footer-col footer-col-2">
        <ul class="social-media-list">
          {site.githubUsername && (
            <li>
              <a href={`https://github.com/${site.githubUsername}`}>
                <span class="username">GitHub / {site.githubUsername}</span>
              </a>
            </li>
          )}

          {site.twitterUsername && (
            <li>
              <a href={`https://twitter.com/${site.twitterUsername}`}>
                <span class="username">Twitter / {site.twitterUsername}</span>
              </a>
            </li>
          )}
        </ul>
      </div>

      <div class="footer-col footer-col-3">
        <p class="text">{site.description}</p>
      </div>
    </div>
  </div>
</footer>
